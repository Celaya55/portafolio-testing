              "// JSONPlaceholder devuelve 200 (OK), otras APIs devuelven 204 (No Content)\r",
              "pm.test(\"Eliminación exitosa (Status 200 o 204)\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);\r",
              "});\r",
              "\r",
              "pm.test(\"El servidor devolvió respuesta vacía o confirmación\", function () {\r",
              "    // Al borrar, la respuesta suele ser {} (objeto vacío)\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.eql({});\r",
              "});"
